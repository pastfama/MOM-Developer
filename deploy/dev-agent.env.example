# Installed as /etc/dev-agent.env (mode 0600). Never commit real values.
PORT=3000

# Conversations live outside the release dir so deploys never delete history.
DATA_DIR=/opt/dev-agent/shared/.data

# Identity of the agent in Foundry.
AGENT_ID=momtv-developer
FOUNDRY_PROJECT_ENDPOINT=https://fameshire-foundry-resource.services.ai.azure.com/api/projects/fameshire-foundry
AGENT_API_VERSION=2025-05-15-preview

# Keyless auth: prefer managed identity. Leave FOUNDRY_API_KEY unset in prod.
FOUNDRY_AUTH=auto
FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
# FOUNDRY_CLIENT_ID=            # only for a user-assigned identity
# FOUNDRY_API_KEY=              # local development only

# Context enrichment (optional).
# GITHUB_PAT=
AZURE_SUBSCRIPTION_ID=8cce2fe7-7c75-4969-9da9-707aadd13e52
AZURE_TENANT_ID=185b412d-bddc-454b-9987-40628582c63c

# Let the agent write files into the repo (0 to disable).
DEV_AGENT_AUTO_APPLY=1
