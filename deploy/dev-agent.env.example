# Installed as /etc/dev-agent.env (mode 0600). Never commit real values.
PORT=3000
# Bind loopback so Caddy is the only public listener (no direct :3000 exposure).
# Set 0.0.0.0 only if you are not using the reverse proxy.
HOST=127.0.0.1

# Conversations live outside the release dir so deploys never delete history.
DATA_DIR=/opt/dev-agent/shared/.data

# Identity of the agent in Foundry (the chat deployment name).
AGENT_ID=gpt-6-luna
FOUNDRY_PROJECT_ENDPOINT=https://mom-dev-foundry.cognitiveservices.azure.com
AGENT_API_VERSION=2024-10-21

# Keyless auth: prefer managed identity. Leave FOUNDRY_API_KEY unset in prod.
FOUNDRY_AUTH=auto
FOUNDRY_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# FOUNDRY_CLIENT_ID=            # only for a user-assigned identity
# FOUNDRY_API_KEY=              # local development only

# Context enrichment (optional).
# GITHUB_PAT=
AZURE_SUBSCRIPTION_ID=8cce2fe7-7c75-4969-9da9-707aadd13e52
AZURE_TENANT_ID=185b412d-bddc-454b-9987-40628582c63c

# Let the agent write files into the repo (0 to disable).
DEV_AGENT_AUTO_APPLY=1

# ── FiveM integration ──
# Set to 0 to disable FiveM features entirely.
FIVEM_ENABLED=1
# Auto-deploy .lua / fxmanifest files to the FiveM server (0 to disable).
FIVEM_AUTO_DEPLOY=1
# Display name for your FiveM server (shown in system prompts and UI).
FIVEM_SERVER_NAME=My FiveM Server

# Deploy method: git | rsync | sftp-rsync
#   git        - push to a git remote (FiveM server pulls from it)
#   rsync      - rsync to local path (FIVEM_DEPLOY_TARGET)
#   sftp-rsync - rsync over SSH to remote host
FIVEM_DEPLOY_METHOD=git

# For rsync method: local path on this VM where resources are copied.
FIVEM_DEPLOY_TARGET=/home/azureuser/fivem-server/resources

# For sftp-rsync method: remote connection details.
# FIVEM_DEPLOY_HOST=your.fivem.server
# FIVEM_DEPLOY_USER=deployuser
# FIVEM_DEPLOY_KEY=~/.ssh/id_rsa
# FIVEM_DEPLOY_REMOTEPATH=/home/deployuser/fivem-server/resources

# Git branch to push to (when method=git).
FIVEM_DEPLOY_BRANCH=main


